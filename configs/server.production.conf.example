# SecureCore production configuration example
# Copy this file to configs/server.production.conf.
# The copied file is ignored by Git.

environment=production

# Direct public deployment should enable TLS.
listen_address=0.0.0.0
listen_port=9443

log_file=logs/securecore-production.log
database_path=data/securecore-production.db
database_pool_size=4
database_acquire_timeout_ms=5000

io_threads=4
worker_threads=4
worker_queue_capacity=512

tls_enabled=true
tls_certificate_file=certs/fullchain.pem
tls_private_key_file=certs/private-key.pem
tls_handshake_timeout_seconds=10

# Direct TLS deployment: do not trust forwarding headers. Behind local Nginx or
# Caddy, set listen_address=127.0.0.1 and trusted_proxy_cidrs=127.0.0.1/32,::1/128.
trusted_proxy_cidrs=none
proxy_forwarded_header_max_bytes=4096

# Replace this origin with the real browser application origin. Production mode
# refuses the wildcard value.
cors_allowed_origins=https://app.example.com
cors_allow_credentials=false
cors_max_age_seconds=600

hsts_enabled=true
hsts_max_age_seconds=31536000
hsts_include_subdomains=true
hsts_preload=false

http_max_connections=4096
http_rate_limit_requests=100
http_rate_limit_window_seconds=1
http_rate_limit_max_buckets=65536

http_max_header_bytes=16384
http_max_body_bytes=1048576

http_read_timeout_seconds=10
http_write_timeout_seconds=10
http_idle_timeout_seconds=30
audit_retention_days=90
metrics_require_auth=true
registration_enabled=false

# Login abuse protection. Lockout duration doubles after repeated lockouts
# until auth_login_max_lockout_seconds is reached.
auth_login_account_failure_limit=5
auth_login_ip_failure_limit=20
auth_login_failure_window_seconds=300
auth_login_lockout_seconds=300
auth_login_max_lockout_seconds=3600
auth_login_max_tracked_accounts=65536
auth_login_max_tracked_ips=65536
