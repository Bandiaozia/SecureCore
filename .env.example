# Shell environment overrides for SecureCore.
# Load manually with: set -a; source .env; set +a
# Do not put private key contents, passwords, or tokens in this file.

SECURECORE_ENVIRONMENT=development
SECURECORE_LISTEN_ADDRESS=127.0.0.1
SECURECORE_LISTEN_PORT=9090
SECURECORE_LOG_FILE=logs/securecore.log
SECURECORE_DATABASE_PATH=data/securecore.db
SECURECORE_DATABASE_POOL_SIZE=4
SECURECORE_DATABASE_ACQUIRE_TIMEOUT_MS=5000
SECURECORE_IO_THREADS=4
SECURECORE_WORKER_THREADS=4
SECURECORE_WORKER_QUEUE_CAPACITY=256
SECURECORE_TLS_ENABLED=false
# SECURECORE_TLS_CERTIFICATE_FILE=certs/fullchain.pem
# SECURECORE_TLS_PRIVATE_KEY_FILE=certs/private-key.pem
SECURECORE_TLS_HANDSHAKE_TIMEOUT_SECONDS=10
SECURECORE_HTTP_MAX_CONNECTIONS=1024
SECURECORE_HTTP_RATE_LIMIT_REQUESTS=100
SECURECORE_HTTP_RATE_LIMIT_WINDOW_SECONDS=1
SECURECORE_HTTP_MAX_HEADER_BYTES=16384
SECURECORE_HTTP_MAX_BODY_BYTES=1048576
SECURECORE_HTTP_READ_TIMEOUT_SECONDS=10
SECURECORE_HTTP_WRITE_TIMEOUT_SECONDS=10
SECURECORE_HTTP_IDLE_TIMEOUT_SECONDS=30
