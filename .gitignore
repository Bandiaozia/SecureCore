/secure-server
/build/

.vscode/*
!.vscode/settings.json

/logs/
/data/

# Local and production configuration overrides
.env
.env.*
!.env.example
/configs/server.local.conf
/configs/server.production.conf

# TLS material must never be committed
/certs/
*.key
*.pem

# Python bytecode cache
__pycache__/
*.py[cod]

# Sanitizer and fuzz build directories
build-*/

# CI and release output
/build-ci-*/
/build-release/
/release-first/
/release-second/
/dist/
